{
  "expo": {
    "name": "Beth Studio",
    "slug": "bethstudio-mobile",
    "scheme": "bethstudio",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1729",
    "ios": {
      "bundleIdentifier": "dev.bethstudio.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada só para ler o QR code de pareamento do BethStudio."
      }
    },
    "android": {
      "package": "dev.bethstudio.mobile",
      "backgroundColor": "#0F1729",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada só para ler o QR code de pareamento do BethStudio.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-audio",
      "expo-sharing",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
