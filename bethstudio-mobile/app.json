{
  "expo": {
    "name": "Beth Studio",
    "slug": "bethstudio-mobile",
    "scheme": "bethstudio",
    "version": "0.2.5",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1729",
    "ios": {
      "bundleIdentifier": "com.exemplo.bethstudio",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Beth Studio usa o microfone só quando você toca em gravar, para ditar texto aos seus terminais. O áudio é enviado ao seu PC e transcrito lá.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.exemplo.bethstudio",
      "versionCode": 1,
      "backgroundColor": "#0F1729",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "O Beth Studio usa o microfone só quando você toca em gravar, para ditar texto aos seus terminais. O áudio é enviado ao seu PC e transcrito lá.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
