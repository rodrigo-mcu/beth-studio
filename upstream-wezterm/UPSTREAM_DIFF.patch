+    /// WezTerminator (patch 0043): derive a new `ConfigHandle` from this
+    /// one with the terminal `font` family replaced by `family`, used to
+    /// render a single pane in a different typeface. This clones the
+    /// FULL config (preserving every other setting — including the
+    /// WezTerminator runtime overrides already merged into this handle)
+    /// and only swaps the font, so it is the right tool for a per-pane
+    /// override (unlike `overridden_config`, which re-reads the config
+    /// file from disk and drops those runtime overrides).
+    ///
+    /// `family` (when `Some`) becomes the PRIMARY font; the handle's
+    /// existing font list is kept after it as fallbacks so box-drawing /
+    /// emoji / CJK glyphs the chosen face lacks still resolve. When
+    /// `family` is `None` the override applies to the config's CURRENT
+    /// primary font (so bold/italic can be set on the window font too).
+    /// `bold` sets the primary weight to Bold; `italic` sets it to
+    /// Italic. The font SIZE is NOT changed here — the GUI applies the
+    /// per-pane size scale separately via `FontConfiguration::change_scaling`.
+    pub fn with_font_override(&self, family: Option<&str>, bold: bool, italic: bool) -> Self {
+        let mut config = (*self.config).clone();
+        // The primary face: a new family if given, else the config's
+        // current primary (cloned so bold/italic apply to the window font).
+        let mut primary = match family {
+            Some(fam) => FontAttributes::new(fam),
+            None => config
+                .font
+                .font
+                .first()
+                .cloned()
+                .unwrap_or_else(|| FontAttributes::new("monospace")),
+        };
+        if bold {
+            primary.weight = FontWeight::BOLD;
+        }
+        if italic {
+            primary.style = FontStyle::Italic;
+        }
+        // Primary first, then the original list as fallbacks. When we set
+        // a new family we keep ALL originals after it; when we modified
+        // the existing primary in place we keep originals from index 1.
+        let skip = if family.is_some() { 0 } else { 1 };
+        let mut attrs = vec![primary];
+        attrs.extend(config.font.font.iter().skip(skip).cloned());
+        config.font.font = attrs;
+        Self {
+            config: Arc::new(config),
+            generation: self.generation,
+        }
+    }
+
+    /// WezTerminator (patch 0043): per-pane family-only override (size and
+    /// style handled separately). Thin wrapper over `with_font_override`.
+    pub fn with_font_family(&self, family: &str) -> Self {
+        self.with_font_override(Some(family), false, false)
+    }
 }
 
