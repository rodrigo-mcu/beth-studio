+        return *size;
+    }
+    let cols = if w_identity {
+        size.cols
+    } else {
+        ((size.cols as f64 / width_factor).floor() as usize).max(1)
+    };
+    let rows = if h_identity {
+        size.rows
+    } else {
+        ((size.rows as f64 / height_factor).floor() as usize).max(1)
+    };
