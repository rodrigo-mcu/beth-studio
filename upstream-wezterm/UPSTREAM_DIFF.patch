+    /// Handle key events when inline header editing is active.
+    /// Returns true if the key was consumed (edit mode continues or ended).
+    fn handle_header_edit_key(
+        &mut self,
+        pane: &Arc<dyn Pane>,
+        window_key: &KeyEvent,
+        context: &dyn WindowOps,
+    ) -> bool {
+        if !window_key.key_is_down {
+            return true; // Ignore key up events
+        }
+
+        let key = self.win_key_code_to_termwiz_key_code(&window_key.key);
+
+        match key {
+            Key::Code(code) => {
+                match code {
+                    TermwizKeyCode::Enter => {
+                        let text = wtinator::header::normalize_header_text(
+                            &self.header_edit_buffer,
+                        )
+                        .ok()
+                        .flatten();
+                        pane.set_header_text(text);
+                        self.editing_header_pane = None;
+                        self.header_edit_buffer.clear();
+                        context.invalidate();
+                        true
+                    }
+                    TermwizKeyCode::Escape => {
+                        // Cancel editing
+                        self.editing_header_pane = None;
+                        self.header_edit_buffer.clear();
+                        context.invalidate();
+                        true
+                    }
+                    TermwizKeyCode::Backspace => {
+                        if !self.header_edit_buffer.is_empty() {
+                            self.header_edit_buffer.pop();
+                            context.invalidate();
+                        }
+                        true
+                    }
+                    TermwizKeyCode::Char(c) => {
+                        if !c.is_control() && c != '\n' && c != '\r'
+                            && self.header_edit_buffer.chars().count()
+                                < wtinator::header::MAX_HEADER_TEXT_LEN
+                        {
+                            self.header_edit_buffer.push(c);
+                            context.invalidate();
+                        }
+                        true
+                    }
+                    _ => {
+                        // Ignore other keys (arrows, etc.) but consume them
+                        true
+                    }
+                }
+            }
+            Key::Composed(s) => {
+                let max = wtinator::header::MAX_HEADER_TEXT_LEN;
+                for c in s.chars() {
+                    if !c.is_control() && c != '\n' && c != '\r'
+                        && self.header_edit_buffer.chars().count() < max
+                    {
+                        self.header_edit_buffer.push(c);
+                    }
+                }
+                context.invalidate();
+                true
+            }
+            Key::None => true,
+        }
+    }
 }
