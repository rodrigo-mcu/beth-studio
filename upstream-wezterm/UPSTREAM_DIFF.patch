+/// `(1.0, 1.0)`, so this is just `scale_size(size, s, s)`. Panes at the
+/// identity factor `(1.0, 1.0)` are returned unchanged.
+fn scale_size(size: &TerminalSize, width_factor: f64, height_factor: f64) -> TerminalSize {
